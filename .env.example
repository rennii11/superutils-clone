CONFIG_PATH=scene.json
WEB_HOST=127.0.0.1
WEB_PORT=3210
# Token bot Discord dùng cho tính năng bot và OAuth.
BOT_TOKEN=

# Discord user ID được phân quyền quản trị, ngăn cách bằng dấu phẩy.
ADMIN_IDS=

# URL gốc công khai dùng để tạo liên kết media.
MEDIA_BASE_URL=
# Client ID của ứng dụng Discord OAuth.
DISCORD_CLIENT_ID=
# Client secret của ứng dụng Discord OAuth.
DISCORD_CLIENT_SECRET=
# URL callback Discord OAuth đã đăng ký cho ứng dụng.
DISCORD_REDIRECT_URI=

# Nhà cung cấp thanh toán
# API token SePay dùng để đọc giao dịch thanh toán.
SEPAY_API_TOKEN=
# Tên ngân hàng hiển thị khi thanh toán.
SEPAY_BANK_NAME=
# Số tài khoản ngân hàng hiển thị cho khách hàng.
SEPAY_BANK_ACCOUNT=
# Tên chủ tài khoản hiển thị khi thanh toán.
SEPAY_BANK_ACCOUNT_NAME=
# URL gốc dùng để tạo liên kết QR thanh toán SePay.
SEPAY_QR_BASE_URL=
# Số ngày trước đó được kiểm tra trong lịch sử giao dịch.
SEPAY_POLL_LOOKBACK_DAYS=
# Thời hạn, tính bằng phút, của liên kết QR SePay.
SEPAY_QR_EXPIRES_MINUTES=
# Số tài khoản nhận tiền SePay.
SEPAY_ACCOUNT_NUMBER=
# URL Discord webhook dùng để gửi thông báo dịch vụ.
DISCORD_WEBHOOK_URL=
# Mã định danh đối tác Card2K.
CARD2K_PARTNER_ID=
# Khóa đối tác Card2K.
CARD2K_PARTNER_KEY=
# URL callback thanh toán Card2K.
CARD2K_CALLBACK_URL=
# Client ID ứng dụng Spotify dùng để tra cứu metadata bài hát.
SPOTIFY_CLIENT_ID=
# Client secret ứng dụng Spotify dùng để tra cứu metadata bài hát.
SPOTIFY_CLIENT_SECRET=

# Secret dùng để mã hóa token lưu cục bộ; hãy tạo giá trị ngẫu nhiên mới.
TOKEN_ENCRYPTION_KEY=
# Application ID Discord dùng cho scene/activity, ngăn cách bằng dấu phẩy.
DISCORD_SCENE_APPLICATION_IDS=
