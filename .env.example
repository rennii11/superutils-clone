# Token bot Discord dùng cho các tính năng bot và Discord OAuth.
BOT_TOKEN=

# Các Discord user ID được phân quyền quản trị, ngăn cách bằng dấu phẩy.
ADMIN_IDS=

# Mã định danh ứng dụng/client Discord OAuth.
DISCORD_CLIENT_ID=
# Client secret của Discord OAuth.
DISCORD_CLIENT_SECRET=
# URL callback Discord OAuth chính xác đã đăng ký cho ứng dụng.
DISCORD_REDIRECT_URI=
# Các application ID Discord dùng cho tính năng scene/activity, ngăn cách bằng dấu phẩy.
DISCORD_SCENE_APPLICATION_IDS=
# URL Discord webhook dùng để gửi thông báo dịch vụ.
DISCORD_WEBHOOK_URL=

# URL gốc công khai dùng khi tạo liên kết media.
MEDIA_BASE_URL=
# Địa chỉ mạng cục bộ mà web server lắng nghe.
WEB_HOST=127.0.0.1
# Cổng TCP cục bộ của web server.
WEB_PORT=3211
# Đường dẫn tùy chọn đến tệp cấu hình dịch vụ.
CONFIG_PATH=

# URL callback thanh toán Card2K.
CARD2K_CALLBACK_URL=
# Mã định danh đối tác Card2K.
CARD2K_PARTNER_ID=
# Khóa đối tác Card2K.
CARD2K_PARTNER_KEY=

# Số tài khoản nhận tiền SePay.
SEPAY_ACCOUNT_NUMBER=
# API token SePay dùng để đọc giao dịch thanh toán.
SEPAY_API_TOKEN=
# Số tài khoản ngân hàng hiển thị cho khách hàng khi thanh toán.
SEPAY_BANK_ACCOUNT=
# Tên chủ tài khoản hiển thị khi thanh toán.
SEPAY_BANK_ACCOUNT_NAME=
# Tên ngân hàng hiển thị khi thanh toán.
SEPAY_BANK_NAME=
# Số ngày trước đó được kiểm tra trong lịch sử giao dịch thanh toán.
SEPAY_POLL_LOOKBACK_DAYS=
# URL gốc dùng để tạo liên kết QR thanh toán SePay.
SEPAY_QR_BASE_URL=
# Thời hạn, tính bằng phút, của liên kết QR SePay được tạo.
SEPAY_QR_EXPIRES_MINUTES=

# Client ID ứng dụng Spotify dùng để tra cứu metadata bài hát.
SPOTIFY_CLIENT_ID=
# Client secret ứng dụng Spotify dùng để tra cứu metadata bài hát.
SPOTIFY_CLIENT_SECRET=

# Secret dùng để mã hóa token lưu cục bộ; hãy tạo giá trị ngẫu nhiên mới.
TOKEN_ENCRYPTION_KEY=
