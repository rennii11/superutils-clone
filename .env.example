# Discord bot token used by bot-backed features and Discord OAuth.
BOT_TOKEN=

# Comma-separated Discord user IDs authorized as administrators.
ADMIN_IDS=

# Discord OAuth application/client identifier.
DISCORD_CLIENT_ID=
# Discord OAuth client secret.
DISCORD_CLIENT_SECRET=
# Exact Discord OAuth callback URL registered for the application.
DISCORD_REDIRECT_URI=
# Comma-separated Discord application IDs used for scene/activity features.
DISCORD_SCENE_APPLICATION_IDS=
# Discord webhook URL for service notifications.
DISCORD_WEBHOOK_URL=

# Public base URL used when generating media links.
MEDIA_BASE_URL=
# Local interface on which the web server listens.
WEB_HOST=127.0.0.1
# Local TCP port for the web server.
WEB_PORT=3211
# Optional path to the service configuration file.
CONFIG_PATH=

# Card2K payment callback URL.
CARD2K_CALLBACK_URL=
# Card2K partner identifier.
CARD2K_PARTNER_ID=
# Card2K partner key.
CARD2K_PARTNER_KEY=

# SePay receiving account number.
SEPAY_ACCOUNT_NUMBER=
# SePay API token used to read payment transactions.
SEPAY_API_TOKEN=
# Bank account number displayed to customers for payments.
SEPAY_BANK_ACCOUNT=
# Account holder name displayed for payments.
SEPAY_BANK_ACCOUNT_NAME=
# Bank name displayed for payments.
SEPAY_BANK_NAME=
# Number of prior days included when checking payment transactions.
SEPAY_POLL_LOOKBACK_DAYS=
# Base URL used to create SePay QR payment links.
SEPAY_QR_BASE_URL=
# Lifetime, in minutes, for generated SePay QR payment links.
SEPAY_QR_EXPIRES_MINUTES=

# Spotify application client identifier for track metadata lookup.
SPOTIFY_CLIENT_ID=
# Spotify application client secret for track metadata lookup.
SPOTIFY_CLIENT_SECRET=

# Secret used to encrypt locally stored tokens; generate a new random value.
TOKEN_ENCRYPTION_KEY=
