  "narrative": {
    "northStar": "The Monochrome Manga Control Page",
    "overview": "Monochrome Manga Panel UI biến workspace thành một trang truyện điều khiển hiện đại. Panel bất đối xứng thể hiện đúng thứ tự thao tác; khoảng trắng tạo rãnh trang; nét mực cứng tạo phân cấp mà không che khuất dữ liệu.\n\nHệ thống ưu tiên tốc độ cấu hình. Phong cách manga chỉ xuất hiện ở khung, nhãn chương, nhãn panel và phản hồi tương tác. Avatar, ảnh preview, timestamp và trạng thái thanh toán giữ màu chức năng.",
    "keyCharacteristics": [
      "Khung panel bất đối xứng theo quan hệ nội dung.",
      "Nền giấy sáng, nét mực tối và bóng lệch cứng.",
      "Sans condensed cho tiêu đề, sans hệ thống cho thao tác, mono cho dữ liệu.",
      "Màu chỉ xuất hiện khi mang ý nghĩa dữ liệu hoặc trạng thái."
    ],
    "rules": [
      {
        "name": "Functional Color Rule",
        "body": "Màu ngoài đen trắng chỉ được dùng cho dữ liệu preview, avatar, timestamp và trạng thái nghiệp vụ.",
        "section": "colors"
      },
      {
        "name": "Modern Manga Type Rule",
        "body": "Tiêu đề phải dùng sans condensed; serif cổ điển bị cấm trong giao diện tác vụ.",
        "section": "typography"
      },
      {
        "name": "Hard Ink Rule",
        "body": "Độ sâu chỉ dùng bóng lệch cứng, không blur và không glassmorphism.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do dùng rãnh panel 18px trên desktop và 14px trên mobile.",
      "Do giữ thứ tự nhập liệu, preview rồi JSON trên màn hình cấu hình.",
      "Do giữ focus dạng viền nét đứt 3px và vùng bấm tối thiểu 42px.",
      "Do giữ màu gốc cho avatar, ảnh preview, timestamp và trạng thái thanh toán."
    ],
    "donts": [
      "Don't dùng giao diện cổ hủ.",
      "Don't dùng bố cục card-grid đồng đều, lặp lại.",
      "Don't dùng glassmorphism và gradient trang trí.",
      "Don't dùng các khuôn mẫu dễ nhận ra là website do AI tạo.",
      "Don't dùng màu làm dấu hiệu trạng thái duy nhất."
