function isManaged(key: string) {
  return children.has(key) || embeddedSessions.has(key)
}

function managedKeys() {
  return new Set([...children.keys(), ...embeddedSessions.keys()])
}

function unitErrorKind(text: string) {
  const auth = text.includes('TOKEN_INVALID') || text.includes('invalid token') || text.includes('Error logging in:') || text.includes('An invalid token was provided')
  const config = text.includes('Missing guildId/channelId/texts') || text.includes('Missing Tokens') || text.includes('Missing Guild or Channel') || text.includes('No auto chat tokens logged in') || text.includes('Missing token')
  return { auth, config }
}

async function recordUnitError(unit: Unit, text: string) {
  const { auth, config } = unitErrorKind(text)
  const line = text.split('\n').find(item => item.includes('Error logging in:') || item.includes('Failed to log in') || item.includes('TOKEN') || item.includes('Missing') || item.includes('invalid token')) || text.split('\n')[0]
  await writeFile(unit.errorFile, line.replace(/["'][A-Za-z0-9._-]{20,}["']/g, '[redacted]').slice(0, 220) + '\n').catch(() => undefined)
  if (auth || config) {
    disabled.set(unit.key, unit.signature)
    if (auth && unit.feature !== 'chatpool') await archiveInvalidTokenFolder(unit.user)
  }
  return { auth, config }
}

function retryUnit(unit: Unit) {
  setTimeout(() => {
    if (embeddedFeatures.has(unit.feature)) {
      console.error(`[${unit.key}] restarting shared process after start failure`)
      void shutdown(1)
      return
    }
    void units().then(list => {
      const next = list.get(unit.key)
      if (next && !isManaged(unit.key) && disabled.get(unit.key) !== next.signature) void start(next)
    })
  }, 5000)
}

async function startEmbedded(unit: Unit) {
  const payload = Buffer.from(JSON.stringify({ id: unit.key, env: unit.env, prefix: `[${unit.user}/${unit.feature}]` }), 'utf8').toString('base64url')
  const moduleUrl = pathToFileURL(resolve(unit.entry))
  moduleUrl.searchParams.set('multiSession', payload)
  moduleUrl.searchParams.set('instance', String(++embeddedInstance))
  registerEmbeddedErrorHandler(unit.key, text => { void recordUnitError(unit, text) })
  try {
    const session = await import(moduleUrl.href) as Partial<EmbeddedSession>
    if (typeof session.stopEmbeddedSession !== 'function') throw new Error(`Embedded module ${unit.entry} does not export stopEmbeddedSession`)
    embeddedSessions.set(unit.key, session as EmbeddedSession)
    managedUnits.set(unit.key, unit)
    missingScans.delete(unit.key)
    idleLogged = false
    signatures.set(unit.key, unit.signature)
    console.log(`[${unit.user}/${unit.feature}] started in shared process`)
  } catch (error) {
    unregisterEmbeddedErrorHandler(unit.key)
    const text = error instanceof Error ? `${error.name}: ${error.message}` : String(error)
    console.error(`[${unit.user}/${unit.feature}] shared start failed: ${text}`)
    const kind = await recordUnitError(unit, text)
    if (!kind.auth && !kind.config) retryUnit(unit)
  }
}

function startChild(unit: Unit) {
  const child = spawn(process.execPath, [unit.entry], {
    env: { ...process.env, ...unit.env },
    stdio: ['pipe', 'pipe', 'pipe']
  })
  children.set(unit.key, child)
  managedUnits.set(unit.key, unit)
  missingScans.delete(unit.key)
  idleLogged = false
  signatures.set(unit.key, unit.signature)
  let mutedAuthError = false
  const prefix = `[${unit.user}/${unit.feature}] `
  child.stdout.on('data', data => process.stdout.write(prefix + data))
  child.stderr.on('data', data => {
    const text = String(data)
    const { auth: authError, config: configError } = unitErrorKind(text)
    if (mutedAuthError && !authError && !configError) return
    process.stderr.write(prefix + (authError || configError ? text.split('\n')[0] + '\n' : text))
    const line = text.split('\n').find(item => item.includes('Error logging in:') || item.includes('Failed to log in') || item.includes('TOKEN') || item.includes('Missing')) || text.split('\n')[0]
    void writeFile(unit.errorFile, line.replace(/["'][A-Za-z0-9._-]{20,}["']/g, '[redacted]').slice(0, 220) + '\n')
    if (authError || configError) {
      disabled.set(unit.key, unit.signature)
      if (authError) {
        mutedAuthError = true
        if (unit.feature !== 'voicepool' && unit.feature !== 'chatpool' && unit.feature !== 'stream') {
          void archiveInvalidTokenFolder(unit.user)
        }
      }
    }
  })
  child.on('exit', code => {
    if (children.get(unit.key) === child) {
      children.delete(unit.key)
      managedUnits.delete(unit.key)
      signatures.delete(unit.key)
    }
    if (stopping.delete(unit.key)) return
    void units().then(list => {
      const next = list.get(unit.key)
      if (next && disabled.get(unit.key) !== next.signature) {
        console.error(prefix + 'exited ' + code + ', restart in 5s')
        setTimeout(() => void start(next), 5000)
      } else if (next) {
        console.error(prefix + 'disabled until config/token changes')
      }
    })
  })
  console.log(prefix + 'started')
}

async function start(unit: Unit) {
  if (isManaged(unit.key)) return
  await rm(unit.errorFile, { force: true })
  if (embeddedFeatures.has(unit.feature)) await startEmbedded(unit)
  else startChild(unit)
}

async function stop(key: string, reason: string) {
  const embedded = embeddedSessions.get(key)
  if (embedded) {
    embeddedSessions.delete(key)
    managedUnits.delete(key)
    signatures.delete(key)
    try { await embedded.stopEmbeddedSession() }
    catch (error) { console.error(`[${key}] shared stop failed:`, error) }
    unregisterEmbeddedErrorHandler(key)
    console.log('[' + key + '] ' + reason)
    return
  }
  const child = children.get(key)
  if (!child) return
  let exited = false
  child.once('exit', () => {
    exited = true
  })
  stopping.add(key)
  child.kill()
  setTimeout(() => {
    if (!exited) child.kill('SIGKILL')
  }, 2500)
  children.delete(key)
  managedUnits.delete(key)
  signatures.delete(key)
  console.log('[' + key + '] ' + reason)
}

async function sync() {
  if (syncing||terminating) return
  syncing = true
  try {
    if (ownsIdentitySync) {
      await reconcileArchivedSlots()
      await archiveExpiredSlots()
      await restoreExpiredSlots()
      await syncUserIdentities()
      await sendInvalidTokenNotices()
    }
    const list = await units()
    for (const [key, unit] of list) {
      if (disabled.get(key) && disabled.get(key) !== unit.signature) disabled.delete(key)
      if (disabled.get(key) === unit.signature) continue
      if (isManaged(key) && signatures.get(key) !== unit.signature) {
        if (embeddedSessions.has(key)) {
          console.log(`[${key}] changed, restarting shared process`)
          await shutdown(1)
          return
        }
        await stop(key, 'changed, restart')
      }
      await start(unit)
    }
    for (const key of managedKeys()) {
      if (list.has(key)) { missingScans.delete(key); continue }
      const misses = (missingScans.get(key) || 0) + 1
      missingScans.set(key, misses)
      const managedUnit = managedUnits.get(key)
      const explicitlyDisabled = managedUnit ? Boolean(await fileSignature(join(managedUnit.root, `${managedUnit.feature}.disabled`))) : false
      if (shouldStopMissingUnit(key, misses, explicitlyDisabled)) {
        const wasEmbedded = embeddedSessions.has(key)
        await stop(key, 'stopped')
        if (shouldRestartSharedProcessAfterStop(wasEmbedded, explicitlyDisabled)) {
          console.log(`[${key}] removed, restarting shared process`)
          await shutdown(1)
          return
        }
      }
    }
    if (!list.size && !children.size && !embeddedSessions.size && !idleLogged) { console.log('No runnable user features in ' + dir + ', idle'); idleLogged = true }
    if (list.size) idleLogged = false
    scheduleExpiry(nextExpiryAt)
  } finally {
    syncing = false
  }
}

