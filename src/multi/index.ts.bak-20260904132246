async function loadToken(path: string) {
  const raw = (await readFile(path, 'utf8')).trim()
  try {
    return String(JSON.parse(raw).token || '')
  } catch {
    return raw
  }
}

function safeFolder(value: string) {
  return /^[\p{L}\p{N}._-]{1,48}$/u.test(value) ? value : ''
}

async function availableArchiveFolder(preferred: string, userId: string) {
  if (!(await stat(join(disabledDir, preferred)).catch(() => null))) return preferred
  for (let index=0;index<100;index++) {
    const suffix='-'+userId.slice(-8)+(index?'-'+index:'')
    const candidate=(preferred.slice(0,Math.max(1,48-suffix.length))+suffix).slice(0,48)
    if (!(await stat(join(disabledDir, candidate)).catch(() => null))) return candidate
  }
  throw new Error('Không thể tạo thư mục users-disable.')
}

async function archivedSlotFolders(slotId: string) {
  const matches:{folder:string;root:string}[]=[]
  for(const entry of await readdir(disabledDir,{withFileTypes:true}).catch(()=>[])){
    if(!entry.isDirectory())continue
    const root=join(disabledDir,entry.name),license=await readFile(join(root,'license.json'),'utf8').then(JSON.parse).catch(()=>null) as {slotId?:string}|null
    if(license?.slotId===slotId)matches.push({folder:entry.name,root})
  }
  return matches
}

async function archivedSlotReason(slotId:string):Promise<SlotArchiveReason> {
  for(const item of await archivedSlotFolders(slotId)){
    const license=await readFile(join(item.root,'license.json'),'utf8').then(JSON.parse).catch(()=>null) as {reason?:unknown}|null
    if(['token_missing','token_invalid','slot_expired','orphan'].includes(String(license?.reason)))return license!.reason as SlotArchiveReason
  }
  return 'token_invalid'
}

async function archiveOrphanFolder(root: string, folder: string) {
  const entries=await readdir(root).catch(()=>[])
  if(!entries.length){await rm(root,{recursive:true,force:true}).catch(()=>{});console.log('['+folder+'] removed empty orphan folder (no billing_slots mapping)');return}
  await mkdir(disabledDir,{recursive:true})
  const licensePath=join(root,'license.json'),license=await readFile(licensePath,'utf8').then(JSON.parse).catch(()=>({})) as Record<string,unknown>
  await writeFile(licensePath,JSON.stringify({...license,reason:'orphan'},null,2)+'\n',{mode:0o600})
  const archiveFolder=await availableArchiveFolder(folder,'orphan-'+Date.now())
  await rename(root,join(disabledDir,archiveFolder)).catch(()=>{})
  await rm(join(disabledDir,archiveFolder,'token.json'),{force:true}).catch(()=>{})
  console.log('['+folder+'] archived orphan folder (no billing_slots mapping) to users-disable')
}

async function restoreText(path: string, value: string|null) {
  if (value===null) await rm(path,{force:true})
  else await writeFile(path,value,{mode:0o600})
}

function reasonSlug(reason: ArchiveReason) {
  return reason.replace(' ','_') as 'token_missing'|'token_invalid'|'slot_expired'
}

async function archiveSlot(row: BillingSlotRow, reason: ArchiveReason, opts: {keepToken?: boolean} = {}) {
  const folder=safeFolder(String(row.folder||'')),userId=String(row.token_user_id||'')
  const slotLock='slot:'+row.id
  if(!folder||!userId||archiving.has(folder)||archiving.has(slotLock))return false
  archiving.add(folder)
  archiving.add(slotLock)
  const sourceRoot=join(dir,folder)
  let archiveRoot='',moved=false
  const previousToken=await readFile(join(sourceRoot,'token.json'),'utf8').catch(()=>null)
  const previousLicense=await readFile(join(sourceRoot,'license.json'),'utf8').catch(()=>null)
  const previousIdentity=await readFile(join(sourceRoot,'identity.json'),'utf8').catch(()=>null)
  try{
    if(!(await stat(sourceRoot).then(item=>item.isDirectory()).catch(()=>false)))return false
    await mkdir(disabledDir,{recursive:true})
    const canonicalFolder=safeFolder(String(row.canonical_folder||''))||folder
    rememberCanonicalFolder.run(folder,row.id)
    await writeFile(join(sourceRoot,'identity.json'),JSON.stringify({userId,username:row.token_username||folder},null,2)+'\n',{mode:0o600})
    await writeFile(join(sourceRoot,'license.json'),JSON.stringify({ownerId:row.owner_id,slotId:row.id,startsAt:row.started_at,expiresAt:Number(row.expires_at),reason:reasonSlug(reason)},null,2)+'\n',{mode:0o600})
    const staleFolders=await archivedSlotFolders(row.id)
    const archiveFolder=await availableArchiveFolder(canonicalFolder,userId);archiveRoot=join(disabledDir,archiveFolder)
    await rename(sourceRoot,archiveRoot);moved=true
    if(!opts.keepToken)await rm(join(archiveRoot,'token.json'),{force:true}).catch(()=>{})
    for(const item of staleFolders)await rm(item.root,{recursive:true,force:true}).catch(()=>{})
    if(archiveFolder!==canonicalFolder&&!(await stat(join(disabledDir,canonicalFolder)).catch(()=>null))){
      const canonicalRoot=join(disabledDir,canonicalFolder)
      await rename(archiveRoot,canonicalRoot);archiveRoot=canonicalRoot
    }
    if(Number(invalidateBoundSlot.run(row.id,folder,userId).changes)!==1)throw new Error('Slot đã thay đổi trong lúc archive.')
    console.log('['+folder+'] archived to users-disable: '+reason)
    return true
  }catch(error){
    if(moved)await rename(archiveRoot,sourceRoot).catch(()=>{})
    if(await stat(sourceRoot).then(item=>item.isDirectory()).catch(()=>false)){
      await restoreText(join(sourceRoot,'token.json'),previousToken).catch(()=>{})
      await restoreText(join(sourceRoot,'license.json'),previousLicense).catch(()=>{})
      await restoreText(join(sourceRoot,'identity.json'),previousIdentity).catch(()=>{})
    }
    console.error('['+folder+'] archive failed:',error instanceof Error?error.message:String(error))
    return false
  }finally{archiving.delete(folder);archiving.delete(slotLock)}
}

async function archiveInvalidTokenFolder(folder: string) {
  const row=billingSlotByFolder.get(folder) as unknown as BillingSlotRow|undefined
  if(!row)return
  const token=await loadToken(join(dir,folder,'token.json')).catch(()=>'')
  if(!token){await archiveSlot(row,'token missing');return}
  const response=await fetch('https://discord.com/api/v10/users/@me',{headers:{Authorization:token},signal:AbortSignal.timeout(10000)}).catch(()=>null)
  if(response?.status===401)await archiveSlot(row,'token invalid')
  else if(!response?.ok)console.error('['+folder+'] invalid-token archive deferred: Discord verification unavailable')
}

async function reconcileArchivedSlots() {
  for(const row of activeBoundSlots.all() as BillingSlotRow[]){
    const folder=safeFolder(String(row.folder||'')),userId=String(row.token_user_id||'')
    if(!folder||!userId||await stat(join(dir,folder)).then(item=>item.isDirectory()).catch(()=>false))continue
    if(!(await archivedSlotFolders(row.id)).length)continue
    if(Number(invalidateBoundSlot.run(row.id,folder,userId).changes)===1)console.log('[slot '+row.id.slice(0,8)+'] reconciled archived token as invalid')
  }
}

async function archiveExpiredSlots() {
  for(const row of activeBoundSlots.all() as BillingSlotRow[]){
    if(Number(row.expires_at)>Date.now())continue
    await archiveSlot(row,'slot expired',{keepToken:true})
  }
}

async function restoreSlot(row:BillingSlotRow,archivedRoot:string,archivedFolderName:string) {
  const slotLock='slot:'+row.id
  const targetFolder=safeFolder(String(row.canonical_folder||archivedFolderName))
  if(!targetFolder||archiving.has(slotLock)||archiving.has(targetFolder))return false
  const identity=await readFile(join(archivedRoot,'identity.json'),'utf8').then(JSON.parse).catch(()=>null) as {userId?:unknown;username?:unknown}|null
  if(typeof identity?.userId!=='string'||!identity.userId||typeof identity.username!=='string'||!identity.username)return false
  if(!(await stat(join(archivedRoot,'token.json')).then(item=>item.isFile()).catch(()=>false)))return false
  const targetRoot=join(dir,targetFolder)
  if(await stat(targetRoot).catch(()=>null))return false
  const context=slotNoticeContext.get(row.id) as unknown as SlotNoticeContextRow|undefined
  archiving.add(slotLock)
  archiving.add(targetFolder)
  const previousLicense=await readFile(join(archivedRoot,'license.json'),'utf8').catch(()=>null)
  let moved=false
  try{
    await mkdir(dir,{recursive:true})
    await rename(archivedRoot,targetRoot);moved=true
    await writeFile(join(targetRoot,'license.json'),JSON.stringify({ownerId:row.owner_id,slotId:row.id,startsAt:row.started_at,expiresAt:Number(row.expires_at)},null,2)+'\n',{mode:0o600})
    if(Number(restoreBoundSlot.run(targetFolder,identity.userId,identity.username,row.id,Date.now()).changes)!==1)throw new Error('Slot đã thay đổi trong lúc restore.')
    identityChecks.delete(targetRoot)
    noticeAttempts.delete(row.id)
    if(context&&WEBHOOK_URL){
      const content=slotArchiveWebhookNotice(context.username,Number(row.position),Number(context.slot_count),'slot_expired',true)
      const webhook=await fetch(WEBHOOK_URL,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({username:'Token Alert',content}),signal:AbortSignal.timeout(10000)}).catch(()=>null)
      if(!webhook?.ok)console.error('[slot '+row.id.slice(0,8)+'] restore webhook failed')
    }
    console.log('['+targetFolder+'] restored from users-disable: slot renewed')
    return true
  }catch(error){
    if(moved){
      await restoreText(join(targetRoot,'license.json'),previousLicense).catch(()=>{})
      await rename(targetRoot,archivedRoot).catch(()=>{})
    }
    console.error('[slot '+row.id.slice(0,8)+'] restore failed:',error instanceof Error?error.message:String(error))
    return false
  }finally{archiving.delete(slotLock);archiving.delete(targetFolder)}
}

async function restoreExpiredSlots() {
  for(const entry of await readdir(disabledDir,{withFileTypes:true}).catch(()=>[])){
    if(!entry.isDirectory())continue
    const archivedRoot=join(disabledDir,entry.name)
    const license=await readFile(join(archivedRoot,'license.json'),'utf8').then(JSON.parse).catch(()=>null) as {slotId?:unknown;reason?:unknown}|null
    if(typeof license?.slotId!=='string'||license.reason!=='slot_expired')continue
    const row=billingSlotById.get(license.slotId) as unknown as BillingSlotRow|undefined
    if(!row||Number(row.expires_at)<=Date.now())continue
    await restoreSlot(row,archivedRoot,entry.name)
  }
}

async function sendInvalidTokenNotices() {
  const botToken=process.env.BOT_TOKEN||''
  if(!botToken)return
  for(const row of pendingInvalidNotices.all() as InvalidNoticeRow[]){
    if((noticeAttempts.get(row.id)||0)>Date.now())continue
    noticeAttempts.set(row.id,Date.now()+TOKEN_HEALTH_INTERVAL_MS)
    const reason=await archivedSlotReason(row.id)
    const dmContent=slotArchiveNotice(Number(row.position),Number(row.slot_count),reason)
    const webhookContent=slotArchiveWebhookNotice(row.username,Number(row.position),Number(row.slot_count),reason,false)
    if(row.invalid_notice_sent_at===null){
      const headers={Authorization:'Bot '+botToken,'content-type':'application/json'}
      const dm=await fetch('https://discord.com/api/v10/users/@me/channels',{method:'POST',headers,body:JSON.stringify({recipient_id:row.owner_id}),signal:AbortSignal.timeout(10000)}).catch(()=>null)
      const channel=await dm?.json().catch(()=>null) as {id?:string}|null
      if(!dm?.ok||!channel?.id)continue
      const sent=await fetch('https://discord.com/api/v10/channels/'+channel.id+'/messages',{method:'POST',headers,body:JSON.stringify({content:dmContent}),signal:AbortSignal.timeout(10000)}).catch(()=>null)
      if(!sent?.ok)continue
      markInvalidDmSent.run(-Date.now(),row.id)
    }
    if(!WEBHOOK_URL)continue
    const webhook=await fetch(WEBHOOK_URL,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({username:'Token Alert',content:webhookContent}),signal:AbortSignal.timeout(10000)}).catch(()=>null)
    if(!webhook?.ok)continue
    markInvalidNoticeSent.run(Date.now(),row.id)
    noticeAttempts.delete(row.id)
    console.log('[slot '+row.id.slice(0,8)+'] archive DM and webhook sent')
  }
}

async function syncUserIdentities() {
  const names = await readdir(dir).catch(() => [])
  for (const user of names.sort()) {
    const root = join(dir, user)
    if (!(await stat(root).catch(() => null))?.isDirectory()) continue
    const tokenPath = join(root, 'token.json')
    const signature = await fileSignature(tokenPath)
    if (!signature) {
      const orphanRow = billingSlotByFolder.get(user) as unknown as BillingSlotRow | undefined
      if (orphanRow && orphanRow.token_user_id) { await archiveSlot(orphanRow, 'token missing'); continue }
      if (!orphanRow) { await archiveOrphanFolder(root, user); continue }
      continue
    }
    const cached = identityChecks.get(root)
    if (cached?.signature === signature && cached.nextAt>Date.now()) continue
    identityChecks.set(root, { signature, nextAt: Date.now()+TOKEN_HEALTH_INTERVAL_MS })
    const token = await loadToken(tokenPath).catch(() => '')
    if (!token) continue
    const response = await fetch('https://discord.com/api/v10/users/@me', { headers: { Authorization: token },signal:AbortSignal.timeout(10000) }).catch(() => null)
    if(response?.status===401){
      await new Promise(resolve=>setTimeout(resolve,4000))
      const recheck=await fetch('https://discord.com/api/v10/users/@me',{headers:{Authorization:token},signal:AbortSignal.timeout(10000)}).catch(()=>null)
      if(recheck?.status===401){const row=billingSlotByFolder.get(user) as unknown as BillingSlotRow|undefined;if(row)await archiveSlot(row,'token invalid')}
      continue
    }
    if (!response?.ok) continue
    const identity = await response.json().catch(() => null) as { id?: string; username?: string } | null
    if (!identity?.id || !identity.username) continue
    const identityPath=join(root,'identity.json'),nextIdentity=JSON.stringify({userId:identity.id,username:identity.username},null,2)+'\n'
    if(await readFile(identityPath,'utf8').catch(()=>'')!==nextIdentity)await writeFile(identityPath,nextIdentity,{mode:0o600})
    updateSlotUsername.run(identity.username,identity.id,user,identity.username)
  }
}

async function fileSignature(path: string) {
  const file = await stat(path).catch(() => null)
  return file?.isFile() ? createHash('sha256').update(await readFile(path)).digest('hex') : ''
}

function imageExt(url: string, contentType: string) {
  const ext = new URL(url).pathname.toLowerCase().match(/\.(png|jpe?g|gif|webp)$/)?.[0]
  if (ext) return ext === '.jpeg' ? '.jpg' : ext
  if (contentType.includes('gif')) return '.gif'
  if (contentType.includes('webp')) return '.webp'
  if (contentType.includes('png')) return '.png'
  return '.jpg'
}

async function cacheDirectRpcImages(user: string, root: string, configPath: string) {
  const raw = await readFile(configPath, 'utf8').catch(() => '')
  let config: any
  try { config = JSON.parse(raw) } catch { return }
  if (!config?.config || typeof config.config !== 'object') return
  const mapPath = join(root, 'media.json')
  const media = JSON.parse(await readFile(mapPath, 'utf8').catch(() => '{}')) as Record<string, string>
  const prefix = `${mediaBaseUrl}/media/${encodeURIComponent(user)}/`
  const mediaFiles: string[] = await readdir(join(root, 'media')).catch(() => [])
  let changed = false
  for (const key of ['bigimg', 'smallimg']) {
    const list = Array.isArray(config.config[key]) ? config.config[key] : []
    for (let index = 0; index < list.length; index++) {
      const source = list[index]
      if (typeof source !== 'string' || !/^https?:\/\//.test(source)) continue
      const reusable = reusableRpcMediaFile(source, prefix, media, mediaFiles)
      if (reusable) {
        const target = prefix + encodeURIComponent(reusable)
        if (list[index] !== target) { list[index] = target; changed = true }
        if (!source.startsWith(prefix) && media[source] !== reusable) { media[source] = reusable; changed = true }
        continue
      }
      if (source.startsWith(prefix)) continue
      try {
        const response = await fetch(source, { signal: AbortSignal.timeout(20000) })
        const contentType = response.headers.get('content-type') || ''
        if (!response.ok || !contentType.startsWith('image/')) continue
        const buffer = Buffer.from(await response.arrayBuffer())
        if (!buffer.length || buffer.length > 8 * 1024 * 1024) continue
        const nameBase = key === 'smallimg' ? (index === 0 ? 'smallimg' : `smallimg-${index + 1}`) : `${index + 1}`
        const name = `${nameBase}-${createHash('sha256').update(buffer).digest('hex').slice(0, 12)}${imageExt(source, contentType)}`
        await mkdir(join(root, 'media'), { recursive: true })
        await writeFile(join(root, 'media', name), buffer)
        mediaFiles.push(name)
        media[source] = name
        list[index] = prefix + encodeURIComponent(name)
        changed = true
      } catch {}
    }
    config.config[key] = list
  }
  if (changed) {
    await writeFile(mapPath, JSON.stringify(media, null, 2) + '\n')
    await writeFile(configPath, JSON.stringify(config, null, 2) + '\n')
  }
}
async function units(): Promise<Map<string, Unit>> {
  const names = await readdir(dir).catch(() => [])
  const found = new Map<string, Unit>()
  nextExpiryAt = Infinity
  for (const user of names.sort()) {
    const root = join(dir, user)
    const rootStat = await stat(root).catch(() => null)
    if (!rootStat?.isDirectory()) continue

    const tokenPath = join(root, 'token.json')
    const token = await fileSignature(tokenPath)
    if (!token) continue
    const licensePath = join(root, 'license.json')
    const licenseRaw = await readFile(licensePath, 'utf8').catch(() => '')
    if (!licenseRaw) continue
    let licenseSignature = ''
    let license: { expiresAt?: number } | null = null
    try { license = JSON.parse(licenseRaw) as { expiresAt?: number } } catch {}
    if (!license || !Number.isFinite(license.expiresAt)) continue
    const expiresAt = Number(license.expiresAt)
    if (expiresAt > Date.now()) nextExpiryAt = Math.min(nextExpiryAt, expiresAt)
    if (expiresAt <= Date.now()) continue
    licenseSignature = await fileSignature(licensePath)

    const configPath = join(root, 'config.json')
    const directConfig = await fileSignature(configPath)
    if (directConfig && directImageScans.get(configPath) !== directConfig) {
      directImageScans.set(configPath, directConfig)
