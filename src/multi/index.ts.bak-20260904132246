async function shutdown(exitCode = 0) {
  if(terminating)return
  terminating=true
  clearTimeout(syncTimer)
  clearTimeout(expiryTimer)
  clearInterval(tokenHealthTimer)
  for (const watcher of watchers) watcher.close()
  for(const key of children.keys())stopping.add(key)
  const managed=[...children.values()]
  const shared=[...embeddedSessions.entries()]
  embeddedSessions.clear()
  children.clear();managedUnits.clear();signatures.clear()
  await Promise.allSettled(shared.map(([,session]) => session.stopEmbeddedSession()))
  await botPresence?.destroy()
  for(const [key] of shared)unregisterEmbeddedErrorHandler(key)
  await terminateChildren(managed)
  billingDb.close()
  process.exit(exitCode)
}

