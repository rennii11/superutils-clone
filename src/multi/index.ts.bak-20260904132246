function queueSync(reason: string, delay = 150) {
  if (terminating || syncTimer) return
  syncTimer = setTimeout(() => {
    syncTimer = undefined
    void sync().catch(error => console.error('Sync failed (' + reason + '):', error instanceof Error ? error.message : String(error)))
  }, delay)
}

if(ownsIdentitySync)tokenHealthTimer=setInterval(()=>queueSync('token health check',0),TOKEN_HEALTH_INTERVAL_MS)

function scheduleExpiry(at: number) {
  clearTimeout(expiryTimer)
  expiryTimer = undefined
  if (!Number.isFinite(at)) return
  expiryTimer = setTimeout(() => {
    expiryTimer = undefined
    queueSync('license expiry', 0)
  }, Math.min(2147483647,Math.max(25, at - Date.now() + 25)))
}

function watchDirectory(path: string) {
  try {
    const watcher = watchPath(path, {recursive: true, persistent: true}, () => queueSync('filesystem change'))
    watcher.on('error', error => console.error('Watcher failed for ' + path + ':', error.message))
    watchers.push(watcher)
  } catch (error) {
    console.error('Watcher could not start for ' + path + ':', error instanceof Error ? error.message : String(error))
  }
}

