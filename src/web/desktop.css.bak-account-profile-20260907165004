/* Status cards align at the top; content must not inflate the whole row. */
@media(min-width:1201px){
  #page-status .status-layout{align-items:start!important}
  #page-status .status-layout>section{height:auto!important;align-self:start!important}
  #page-status .status-list-panel{display:block!important;min-height:0!important}
  #page-status .status-items{display:grid!important;max-height:520px!important}
  #page-status .status-builder-head{margin-top:0!important}
}
@media(min-width:1201px){#page-status .grid>section:nth-child(2){margin-top:0!important}}

/* Guest Free CTA matches paid-plan CTA geometry; only label/action differ. */
#page-plan .plan-card[data-plan-id="free"] .plan-card-actions button:not(:disabled){
  min-height:36px!important;
  width:auto!important;
  min-width:112px!important;
  justify-self:end!important;
  padding:0 18px!important;
  border:1px solid color-mix(in srgb,var(--dash-accent) 72%,white 28%)!important;
  border-radius:999px!important;
  background:linear-gradient(135deg,var(--dash-accent),color-mix(in srgb,var(--dash-accent) 65%,#fff 35%))!important;
  color:var(--dash-accent-ink)!important;
  font-weight:800!important;
  letter-spacing:.02em!important;
  box-shadow:0 8px 24px -18px var(--dash-accent)!important;
}
#page-plan .plan-card[data-plan-id="free"] .plan-card-actions button:not(:disabled):hover{transform:translateY(-1px)!important}

/* Desktop sidebar: keep brand/account fixed; scroll only the function list. */
@media(min-width:1201px){
  .topbar{overflow:hidden!important}
  .topbar .tabs{min-height:0!important;flex:1 1 auto!important;overflow-y:auto!important;overflow-x:hidden!important;align-content:start!important;scrollbar-width:thin!important;scrollbar-color:var(--dash-muted) transparent!important}
  .topbar .tabs::-webkit-scrollbar{width:6px!important}
  .topbar .tabs::-webkit-scrollbar-track{background:transparent!important}
  .topbar .tabs::-webkit-scrollbar-thumb{border:0!important;border-radius:999px!important;background:var(--dash-muted)!important}
  .topbar .account{flex:0 0 auto!important}
}

.brand-mark{width:28px;height:28px;object-fit:contain;border-radius:7px;vertical-align:middle;margin:0 8px 0 0}
.brand::before,.mobile-brand::before{display:none!important}

/* Scene deletion confirmation: reset native dialog chrome before styling the panel. */
dialog.web-confirm-dialog{width:min(420px,calc(100vw - 32px));margin:auto!important;padding:0!important;border:0!important;background:transparent!important;color:var(--dash-ink)!important;overflow:visible}
dialog.web-confirm-dialog::backdrop{background:rgba(0,0,0,.68);backdrop-filter:blur(4px)}
.web-confirm-box{width:100%;margin:0!important;padding:24px!important;border:1px solid rgba(255,255,255,.16)!important;border-radius:16px!important;background:#141619!important;color:#f5f5f5!important;box-shadow:0 20px 60px rgba(0,0,0,.55)!important}
.web-confirm-title{margin:0 0 8px!important;color:#f5f5f5!important;font:700 21px/1.2 "Be Vietnam Pro",sans-serif!important;letter-spacing:-.025em!important}
.web-confirm-msg{margin:0!important;color:#a9afb7!important;font:400 14px/1.55 "Be Vietnam Pro",sans-serif!important}
.web-confirm-actions{display:flex!important;gap:10px!important;margin-top:22px!important}.web-confirm-actions button{flex:1!important;min-height:42px!important;margin:0!important;border-radius:9px!important;font:700 14px "Be Vietnam Pro",sans-serif!important}.web-confirm-cancel{border:1px solid rgba(255,255,255,.16)!important;background:#22252a!important;color:#f5f5f5!important}.web-confirm-ok.danger{border-color:#ef4444!important;background:#ef4444!important;color:#fff!important}

.account-home-profile #homePlanExpiry{display:grid;gap:2px}.account-home-profile #homePlanExpiryTime,.account-home-profile #homePlanExpiryDate{display:block}.account-home-profile #homePlanExpiryTime{font-size:1.05em}.account-home-profile #homePlanExpiryDate{color:var(--dash-muted);font-size:.92em}
