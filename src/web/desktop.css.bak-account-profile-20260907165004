html{background:var(--color-background);color-scheme:light}
body{
  min-height:100vh;
  background:var(--color-background)!important;
  color:var(--color-foreground);
  font-family:"Be Vietnam Pro","Aptos","Segoe UI",sans-serif;
  letter-spacing:0
}
.boot-screen{display:none}
html[data-booting] body{overflow:hidden}
html[data-booting] .shell{visibility:hidden}
html[data-booting] .boot-screen{
  position:fixed;
  inset:0;
  z-index:9999;
  display:grid;
  place-content:center;
  justify-items:center;
  gap:14px;
  background:var(--color-background);
  color:var(--color-foreground)
}
.boot-screen strong{font:900 13px/1 "Be Vietnam Pro",sans-serif;letter-spacing:.12em;text-transform:uppercase}
.boot-spinner{width:38px;height:38px;border:4px solid var(--ui-ink);border-right-color:transparent;border-radius:50%;animation:boot-spin .7s linear infinite}
@keyframes boot-spin{to{transform:rotate(360deg)}}
@media(prefers-reduced-motion:reduce){.boot-spinner{animation-duration:1.4s}}
body::before{
  content:"";
  position:fixed;
  top:0;
  right:0;
  z-index:-1;
  width:340px;
  height:340px;
  background-image:var(--ui-accent-pattern);
  background-size:10px 10px;
  -webkit-mask-image:radial-gradient(circle at 100% 0,black,transparent 70%);
  mask-image:radial-gradient(circle at 100% 0,black,transparent 70%);
  opacity:.35;
  pointer-events:none
}
.shell{
  width:100%;
  max-width:none;
  min-height:100vh;
  display:grid;
  grid-template-columns:236px minmax(0,1fr);
  gap:var(--ui-gutter);
  padding:14px;
  background:transparent
}

