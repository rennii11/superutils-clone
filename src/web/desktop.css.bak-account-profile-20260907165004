/* Fixed monochrome theme switch. It floats above panels without changing layout. */
:root[data-theme="dark"]{
  --ui-paper:oklch(.19 .014 258);
  --ui-paper-soft:oklch(.24 .016 258);
  --ui-paper-muted:oklch(.15 .012 258);
  --ui-ink:oklch(.94 .006 90);
  --ui-ink-soft:oklch(.76 .01 90);
  --ui-gray:oklch(.57 .010 92);
  --ui-stroke:1px;
  --ui-stroke-thin:1px;
  --ui-accent-red:oklch(.68 .18 25);
  --ui-accent-red-strong:oklch(.74 .18 25);
  --ui-accent-yellow:oklch(.82 .15 95);
  --ui-accent-yellow-strong:oklch(.78 .16 90);
  --ui-accent-blue:oklch(.70 .15 255);
  --ui-accent-blue-strong:oklch(.76 .14 255);
  --ui-accent-green:oklch(.72 .15 148);
  --color-background:var(--ui-paper-muted);
  --color-surface:var(--ui-paper);
  --color-surface-muted:var(--ui-paper-soft);
  --color-foreground:var(--ui-ink);
  --color-muted-foreground:var(--ui-ink-soft);
  --color-border:var(--ui-ink);
  --color-focus:var(--ui-accent-blue);
  --color-accent:var(--ui-accent-yellow);
  --color-success:var(--ui-accent-green);
  --color-warning:var(--ui-accent-yellow-strong);
  --color-danger:var(--ui-accent-red);
  --panel-bg:var(--ui-paper);
  --panel-border:var(--ui-ink);
  --button-bg:var(--ui-accent-blue);
  --button-bg-hover:var(--ui-accent-blue-strong);
  --button-bg-active:var(--ui-paper-soft);
  --button-fg:var(--ui-paper);
  --button-fg-hover:var(--ui-paper);
  --input-bg:var(--ui-paper);
  --input-border:var(--ui-ink);
  --input-focus-ring:var(--ui-accent-blue);
  --card-bg:var(--ui-paper);
  --card-border:var(--ui-ink);
  --night:var(--ui-paper-muted);
  --deep:var(--ui-paper);
  --surface:var(--ui-paper);
  --surface-raised:var(--ui-paper-soft);
  --ink:var(--ui-ink);
  --soft:var(--ui-ink-soft);
  --muted:var(--ui-gray);
  --line:var(--ui-ink);
  --cyan:var(--ui-accent-blue);
