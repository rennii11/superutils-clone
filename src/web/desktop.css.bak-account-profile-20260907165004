/* Legacy co dien theme: red-yellow-blue accents on black-ink/white-paper legacy base. */
:root{
  /* Primitive tokens */
  --ui-paper:oklch(.985 .006 90);
  --ui-paper-soft:oklch(.95 .008 88);
  --ui-paper-muted:oklch(.90 .010 85);
  --ui-ink:oklch(.16 .01 260);
  --ui-ink-soft:oklch(.34 .012 260);
  --ui-gray:oklch(.55 .01 260);
  --ui-stroke:1px;
  --ui-stroke-thin:1px;
  --ui-gutter:18px;
  --ui-space-1:6px;
  --ui-space-2:10px;
  --ui-space-3:14px;
  --ui-space-4:18px;
  --ui-space-5:24px;
  --ui-space-6:32px;
  --ui-radius:1px;
  --ui-accent-red:oklch(.58 .21 25);
  --ui-accent-red-strong:oklch(.50 .22 25);
  --ui-accent-yellow:oklch(.86 .17 95);
  --ui-accent-yellow-strong:oklch(.80 .18 90);
  --ui-accent-blue:oklch(.52 .18 255);
  --ui-accent-blue-strong:oklch(.44 .19 258);
  --ui-accent-green:oklch(.62 .16 148);
  --ui-accent-pattern:none;
  --ui-accent-pattern-accent:none;

  /* Semantic tokens */
  --color-background:var(--ui-paper-muted);
  --color-surface:var(--ui-paper);
  --color-surface-muted:var(--ui-paper-soft);
  --color-foreground:var(--ui-ink);
  --color-muted-foreground:var(--ui-ink-soft);
  --color-border:var(--ui-ink);
  --color-focus:var(--ui-accent-blue);
  --color-accent:var(--ui-accent-yellow);
  --color-success:var(--ui-accent-green);
  --color-warning:var(--ui-accent-yellow-strong);
  --color-danger:var(--ui-accent-red);

  /* Component tokens */
  --panel-bg:var(--color-surface);
  --panel-border:var(--color-border);
  --button-bg:var(--ui-accent-blue);
  --button-bg-hover:var(--ui-accent-blue-strong);
  --button-bg-active:var(--ui-paper-muted);
  --button-fg:var(--ui-paper);
  --button-fg-hover:var(--ui-paper);
  --input-bg:var(--ui-paper);
  --input-border:var(--ui-ink);
  --input-focus-ring:var(--ui-accent-blue);
  --card-bg:var(--panel-bg);
  --card-border:var(--panel-border);
  --night:var(--ui-paper-muted);
  --deep:var(--ui-paper);
  --surface:var(--ui-paper);
  --surface-raised:var(--ui-paper);
  --ink:var(--ui-ink);
  --soft:var(--ui-ink-soft);
  --muted:var(--ui-gray);
  --line:var(--ui-ink);
  --cyan:var(--ui-accent-blue);
  --cyan-dark:var(--ui-paper);
  --violet:var(--ui-ink)
}

