    <section class="page" id="page-chatpool">
      <h1>Tạo Multi Chat Config</h1>
      <div class="config-slot-switcher" data-slot-switcher hidden>
        <label>Token cấu hình<select data-slot-select aria-label="Chọn slot cấu hình"></select></label>
        <span>Mỗi slot dùng một bộ config riêng.</span>
      </div>
      <div class="grid">
        <section>
          <label>Tokens, mỗi dòng 1 token<textarea id="chatpoolTokens"></textarea></label>
          <label>Guild ID<input id="chatpoolGuild" placeholder="Server ID"></label>
          <label>Channel ID<input id="chatpoolChannel" placeholder="Text channel ID"></label>
          <div class="row">
            <label>Delay giây<input id="chatpoolDelay" type="number" min="0.1" step="0.1" value="30"></label>
            <label>Chế độ chat<select id="chatpoolRandom"><option value="ordered">Theo thứ tự</option><option value="random">Random</option><option value="text-war">Text War</option></select></label>
          </div>
          <label id="chatpoolTargetField" hidden>ID user cần ping<input id="chatpoolTargetUser" inputmode="numeric" placeholder="Discord User ID"></label>
          <label id="chatpoolTextsField">Text, mỗi dòng 1 tin<textarea id="chatpoolTexts">text 1
text 2
text 3</textarea></label>
          <div class="chat-image-field"><label class="chat-image-picker"><span>Ảnh đính kèm</span><b>Chọn ảnh</b><input id="chatpoolImageFile" type="file" accept="image/png,image/jpeg,image/gif,image/webp"><input id="chatpoolImage" type="hidden"></label><div class="chat-image-preview"><img id="chatpoolImagePreview" alt="Ảnh đính kèm Multi Chat" hidden><span id="chatpoolImageName">Chưa chọn ảnh</span><button id="chatpoolImageRemove" type="button" hidden>Xóa ảnh</button></div></div>
        </section>
        <section>
          <div id="chatpoolErrors"></div>
          <textarea id="chatpoolOutput" spellcheck="false"></textarea>
          <div class="actions">
            <button class="feature-toggle" id="chatpoolToggle" type="button" disabled>Tắt chức năng</button>
            <button class="save-control" id="chatpoolSave" disabled>Lưu config & Discord</button>
          </div>
        </section>
      </div>
    </section>
    <section class="page" id="page-status">
      <h1>Tạo Status Config</h1>
      <div class="config-slot-switcher" data-slot-switcher hidden>
        <label>Token cấu hình<select data-slot-select aria-label="Chọn slot cấu hình"></select></label>
        <span>Mỗi slot dùng một bộ config riêng.</span>
      </div>
      <p class="billing-note">Bật Status sẽ ghi đè custom status hiện tại của tài khoản khi đang chạy. Custom status gốc (text, emoji) được lưu lại và tự khôi phục khi tắt chức năng — trừ khi bạn tự đổi status thủ công trong lúc chức năng đang bật, lúc đó khi tắt sẽ khôi phục về status gốc lúc bật, không phải status vừa đổi.</p>
      <p class="billing-note">Lưu ý hiển thị: chính tài khoản này khi tự xem lại Settings/Profile của mình vẫn thấy custom status gốc, KHÔNG thấy status đang xoay vòng — vì status xoay vòng chỉ gửi qua kết nối trạng thái (presence), Discord không cập nhật lại vào Settings gốc. Ngược lại, người khác nhìn vào tài khoản này qua Discord (bạn bè, server chung...) sẽ thấy đúng status đang xoay vòng theo cấu hình bên dưới.</p>
      <div class="grid status-layout">
        <section class="status-controls">
          <div class="status-mode-grid">
            <label>Chế độ status<select id="statusMode"><option value="ordered">Theo thứ tự</option><option value="random">Random</option></select></label>
            <label>Chế độ delay<select id="statusDelayMode"><option value="global">Delay toàn bộ</option><option value="per-status">Delay từng status</option></select></label>
            <label>Chế độ emoji<select id="statusEmojiMode"><option value="global">Emoji chung</option><option value="per-status">Emoji từng status</option></select></label>
          </div>
          <label class="status-global-delay" id="statusGlobalDelay">Delay toàn bộ, giây<input id="statusDelay" type="number" min="3" step="1" value="30"></label>
          <div class="status-global-emoji" id="statusGlobalEmoji">
            <label>Emoji chung (&lt;:name:id&gt;/&lt;a:name:id&gt;)<input id="statusEmojiInput"></label>
          </div>
        </section>
        <section class="status-list-panel">
          <div class="status-builder-head">
            <div><b id="statusListTitle">Danh sách status</b><span>Tối đa 100 status</span></div>
            <button class="status-add" id="statusAdd" type="button">+ Thêm status</button>
          </div>
          <div class="status-items" id="statusItems" aria-labelledby="statusListTitle" aria-live="polite"></div>
        </section>
        <section class="status-json-panel">
          <div id="statusErrors"></div>
          <textarea id="statusOutput" spellcheck="false"></textarea>
          <div class="actions">
            <button class="feature-toggle" id="statusToggle" type="button" disabled>Tắt chức năng</button>
            <button class="save-control" id="statusSave" disabled>Lưu config & Discord</button>
          </div>
        </section>
      </div>
    </section>
    <section class="page" id="page-stream">
      <h1>Video Stream</h1>
      <div class="grid stream-grid">
        <section>
          <p class="billing-note" id="streamEligibility">Cần ít nhất một token còn hạn.</p>
          <label>Account điều khiển<input id="streamController" readonly></label>
          <label>Prefix<input id="streamPrefix" value="n!" maxlength="32" autocomplete="off"></label>
          <label>Username token<input id="streamTokenUsername" readonly value="Chưa có token"></label>
          <label>Token Stream<input id="streamToken" type="password" placeholder="Dán token Stream" autocomplete="new-password"></label>
          <div class="actions">
            <button class="feature-toggle" id="streamToggle" type="button" disabled>Tắt chức năng</button>
            <button id="streamSave" type="button" disabled>Lưu Stream</button>
          </div>
          <div id="streamMessage" role="status" aria-live="polite"></div>
        </section>
        <section>
          <h2>Lệnh Discord</h2>
          <div class="stream-command-list">
            <code>cam &lt;URL hoặc từ khóa&gt; [xN|loop]</code>
            <code>live &lt;URL hoặc từ khóa&gt; [xN|loop]</code>
            <code>queue · skip · pause · resume · disconnect</code>
          </div>
          <p class="billing-note">Token Stream phải ở cùng server Discord với Account điều khiển. Người điều khiển phải vào voice trước. Stream tự dừng khi account không còn slot hợp lệ.</p>
        </section>
      </div>
    </section>
    <section class="page" id="page-quest">
      <h1>Auto Quest</h1>
      <div class="config-slot-switcher" data-slot-switcher hidden>
        <label>Token Quest<select data-slot-select aria-label="Chọn slot Quest"></select></label>
        <span>Mỗi slot dùng một lịch Quest riêng.</span>
      </div>
      <div class="quest-grid">
        <section class="quest-control-panel">
          <div class="quest-state-line">
            <span>Trạng thái</span>
            <strong id="questStateBadge" data-state="idle">CHƯA BẬT</strong>
          </div>
          <div class="row quest-form-row">
            <label>Loại nhiệm vụ<select id="questType"><option value="BOTH">Tất cả</option><option value="DECOR">Decor</option><option value="ORBS">Orbs</option></select></label>
            <label>Thời hạn<select id="questDays"><option value="0">Vĩnh viễn</option><option value="1">1 ngày</option><option value="2">2 ngày</option><option value="3">3 ngày</option><option value="4">4 ngày</option><option value="5">5 ngày</option><option value="6">6 ngày</option><option value="7">7 ngày</option></select></label>
          </div>
          <p class="quest-copy" id="questScheduleCopy">Chạy theo lịch sẽ chạy ngay lượt đầu, sau đó lặp lại mỗi 24 giờ.</p>
          <div class="actions quest-actions" id="questActions" hidden>
            <button id="questDisable" type="button" disabled>Tắt Quest</button>
            <button id="questRun" type="button" disabled>Chạy 1 lần</button>
            <button id="questEnable" type="button" disabled>Chạy theo lịch</button>
          </div>
          <p class="quest-copy" id="questFreeInfo" role="status" aria-live="polite" hidden></p>
          <p class="quest-message" id="questMessage" role="status" aria-live="polite" data-state="unavailable">Đăng nhập để sử dụng Auto Quest.</p>
        </section>
        <section class="quest-status-panel">
          <dl class="quest-status-list">
            <div><dt>Token</dt><dd id="questTokenState">Chưa gắn</dd></div>
            <div><dt>Lịch</dt><dd id="questScheduleState">Chưa cấu hình</dd></div>
            <div><dt>Hết hạn</dt><dd id="questExpires">Không có</dd></div>
            <div><dt>Lượt tiếp theo</dt><dd id="questNextRun">Chưa lên lịch</dd></div>
            <div><dt>Lượt gần nhất</dt><dd id="questLastRun">Chưa chạy</dd></div>
          </dl>
          <div class="quest-progress" id="questProgress" hidden>
            <div class="quest-progress-head"><strong id="questProgressName"></strong><span id="questProgressLabel"></span></div>
            <div class="quest-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><i id="questProgressBar"></i></div>
          </div>
          <p class="quest-summary" id="questSummary">Chưa có dữ liệu chạy Quest.</p>
        </section>
      </div>
    </section>
    <section class="page" id="page-api">
      <h1>Placeholder API</h1>
      <div class="api-info" id="apiInfo">
        <h2>Chọn một placeholder</h2>
        <p>Ấn vào placeholder bên dưới để xem ý nghĩa và ví dụ.</p>
      </div>
      <div class="api">
        <code>{hour:1}</code><code>{hour:2}</code><code>{min:1}</code>
        <code>{min:2}</code><code>{th=date}</code><code>{th=month:1}</code>
        <code>{en=date}</code><code>{en=week:1}</code><code>{en=week:2}</code>
        <code>{en=month:1}</code><code>{en=month:2}</code><code>{en=month:3}</code>
        <code>{en=year:1}</code><code>{en=year:2}</code><code>{city}</code>
        <code>{region}</code><code>{country}</code><code>{temp:c}</code>
        <code>{temp:f}</code><code>{wind:kph}</code><code>{wind:mph}</code>
        <code>{wind:degree}</code><code>{wind:dir}</code><code>{pressure:mb}</code>
        <code>{pressure:in}</code><code>{precip:mm}</code><code>{precip:in}</code>
        <code>{gust:kph}</code><code>{gust:mph}</code><code>{feelslike:c}</code>
        <code>{feelslike:f}</code><code>{windchill:c}</code><code>{windchill:f}</code>
        <code>{heatindex:c}</code><code>{heatindex:f}</code><code>{dewpoint:c}</code>
        <code>{dewpoint:f}</code><code>{vis:km}</code><code>{vis:mi}</code>
        <code>{humidity}</code><code>{cloud}</code><code>{uv}</code>
        <code>{co}</code><code>{no2}</code><code>{o3}</code>
        <code>{so2}</code><code>{pm2.5}</code><code>{pm10}</code>
        <code>{user:name}</code><code>{guild=members:SERVER_ID}</code><code>{guild=name:SERVER_ID}</code>
        <code>{guild=icon:SERVER_ID}</code><code>{emoji:random}</code><code>{emoji:time}</code>
        <code>{emoji:clock}</code>
      </div>
    </section>
  </main>
  </div>
  <dialog class="json-dialog" id="jsonDialog" aria-labelledby="jsonDialogTitle">
    <button class="dialog-close" id="closeJsonDialog" type="button" aria-label="Đóng JSON">×</button>
    <p class="json-dialog-kicker">PANEL 03 / JSON</p>
    <h2 id="jsonDialogTitle">JSON scene</h2>
    <textarea id="output" spellcheck="false" aria-label="JSON scene"></textarea>
    <div class="actions json-dialog-actions">
      <button class="save-control" id="saveJson" disabled>Lưu scene & Discord</button>
    </div>
  </dialog>
  <dialog class="token-unbind-dialog" id="tokenUnbindDialog" aria-labelledby="tokenUnbindDialogTitle" aria-describedby="tokenUnbindDialogCopy">
    <p class="token-unbind-kicker">TOKEN / GỠ LIÊN KẾT</p>
    <h2 id="tokenUnbindDialogTitle">Gỡ token?</h2>
    <p id="tokenUnbindDialogCopy">Token sẽ bị xóa khỏi slot. Slot và thời hạn còn lại được giữ nguyên.</p>
    <p class="token-unbind-status" id="tokenUnbindStatus" role="status" aria-live="polite"></p>
    <div class="token-unbind-actions">
      <button id="cancelTokenUnbind" type="button">Giữ token</button>
      <button id="confirmTokenUnbind" type="button">Gỡ token</button>
    </div>
  </dialog>
  <dialog class="payment-dialog" id="paymentDialog">
    <button class="dialog-close" id="closePaymentDialog" type="button" aria-label="Đóng">×</button>
    <p class="payment-eyebrow">THANH TOÁN</p>
    <h2>Quét mã QR</h2>
    <p class="dialog-copy" id="paymentSummary"></p>
    <div class="payment-loading" id="paymentLoading" role="status" aria-live="polite" hidden><i aria-hidden="true"></i><span>Đang tạo mã QR...</span><small>Giữ cửa sổ này mở</small></div>
    <img id="paymentQr" alt="Mã QR thanh toán">
    <dl class="payment-details" id="paymentDetails"><div><dt>Số tiền</dt><dd id="paymentAmount"></dd></div><div><dt>Nội dung</dt><dd id="paymentInvoice"></dd></div></dl>
    <p class="countdown">Mã hết hạn sau <strong id="paymentCountdown">10:00</strong></p>
    <p class="billing-note" id="paymentStatus" role="status">Chờ xác nhận giao dịch.</p>
    <div class="payment-actions"><button id="cancelPaymentDialog" type="button">Hủy thanh toán</button></div>
  </dialog>
    <script src="/app.js"></script>

</body>
</html>
