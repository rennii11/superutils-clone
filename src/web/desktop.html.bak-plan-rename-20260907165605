    <section class="page" id="page-voicepool">
      <h1>Tạo Multi Voice Config</h1>
      <div class="config-slot-switcher" data-slot-switcher hidden>
        <label>Token cấu hình<select data-slot-select aria-label="Chọn slot cấu hình"></select></label>
        <span>Mỗi slot dùng một bộ config riêng.</span>
      </div>
