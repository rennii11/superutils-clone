            <button class="feature-toggle" id="voicepoolToggle" type="button" disabled>Tắt chức năng</button>
            <button class="save-control" id="voicepoolSave" disabled>Lưu config & Discord</button>
          </div>
        </section>
      </div>
    </section>
    <section class="page" id="page-chat">
      <h1>Tạo Auto Chat Config</h1>
      <div class="config-slot-switcher" data-slot-switcher hidden>
        <label>Token cấu hình<select data-slot-select aria-label="Chọn slot cấu hình"></select></label>
        <span>Mỗi slot dùng một bộ config riêng.</span>
