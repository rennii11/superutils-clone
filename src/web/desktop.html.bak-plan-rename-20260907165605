            <label>Camera<select id="voicepoolCamera"><option value="false">Tắt</option><option value="true">Bật</option></select></label>
          </div>
          <div class="row">
            <label>Mic<select id="voicepoolMute"><option value="true">Bật</option><option value="false">Tắt</option></select></label>
