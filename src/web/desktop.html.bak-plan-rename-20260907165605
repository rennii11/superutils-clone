    <main>
    <div class="account-notices" id="accountNotices" role="status" aria-live="polite" hidden></div>
    <section class="page active" id="page-config">
    <h1>Rich Presence</h1>
      <div class="config-slot-switcher" data-slot-switcher hidden>
        <label>Token<select data-slot-select aria-label="Chọn token"></select></label>
        <span>Mỗi token dùng các scene riêng.</span>
      </div>
    <div class="grid">
      <section>
        <div class="config-fields">
        <div class="row">
          <label>Thành phố/tỉnh<select id="city"><option>An Giang</option><option>Bắc Ninh</option><option>Cà Mau</option><option>Cao Bằng</option><option>Cần Thơ</option><option>Đà Nẵng</option><option>Đắk Lắk</option><option>Điện Biên</option><option>Đồng Nai</option><option selected>Đồng Tháp</option><option>Gia Lai</option><option>Hà Nội</option><option>Hà Tĩnh</option><option>Hải Phòng</option><option>Hưng Yên</option><option>Huế</option><option>Khánh Hòa</option><option>Lai Châu</option><option>Lạng Sơn</option><option>Lào Cai</option><option>Lâm Đồng</option><option>Nghệ An</option><option>Ninh Bình</option><option>Phú Thọ</option><option>Quảng Ngãi</option><option>Quảng Ninh</option><option>Quảng Trị</option><option>Sơn La</option><option>Tây Ninh</option><option>Thái Nguyên</option><option>Thanh Hóa</option><option>Hồ Chí Minh</option><option>Tuyên Quang</option><option>Vĩnh Long</option></select></label>
          <label>Delay giây<input id="delay" type="number" min="1" value="4"></label>
        </div>
        <label>RPC mode<select id="mode"><option>RICH_PRESENCE</option><option>META_QUEST</option><option>SPOTIFY</option></select></label>
        <div id="spotifySearchField" class="spotify-search" hidden>
          <label for="spotifyQuery">Tên bài, album, tác giả hoặc link Spotify</label>
          <div class="spotify-search-row spotify-search-wrap"><input id="spotifyQuery" autocomplete="off" placeholder="Nhập tên bài, album, tác giả..."><button id="spotifyClear" type="button" class="spotify-clear" aria-label="Xóa từ khoá">×</button></div>
          <div id="spotifyResults" class="spotify-results" role="listbox" aria-label="Kết quả Spotify"></div>
          <div id="spotifySelected" class="spotify-selected"><small class="spotify-selected-title">Danh sách phát (bấm kết quả để thêm)</small></div>
          <button id="spotifyAutoPlay" type="button" aria-pressed="true">Auto-play: Bật</button>
        </div>
        <label id="typeField">Type<select id="type"><option>LISTENING</option><option>PLAYING</option><option>WATCHING</option><option>STREAMING</option><option>COMPETING</option></select></label>
        <label id="streamURLField" hidden>Stream URL<input id="streamURL" type="url" placeholder="https://www.twitch.tv/..."></label>
        <div class="row">
          <label>Start timestamp<input id="start" value="11/07/2008"></label>
          <label>End timestamp<input id="end" placeholder="null"></label>
        </div>
        <label id="nameField">Name, mỗi dòng 1 name<textarea id="name">Naiya</textarea></label>
        <label id="text1Field">Text 1<textarea id="text1">꒰⊹{th=date}/{th=month:1}/{en=year:2}⊹꒱</textarea></label>
        <label id="text2Field">Text 2, mỗi dòng 1 item<textarea id="text2">‧₊˚🌙 Iroha Sakayor 🌙 ⋆｡˚ ⋆
‧₊˚.💞ｄａｉｓｕｋｉ💞✧.*
‧₊˚♡ｉｌｏｖｅｙｏｕ♡⋆｡˚ ⋆</textarea></label>
        <label id="text3Field">Text 3, mỗi dòng 1 item<textarea id="text3">‧₊˚.🌡️⊹{temp:c} °C 🍃⊹{wind:kph} km/h ✧.*
‧₊˚.🌨️⊹{cloud} % ┊ 🌤️⊹{uv} uv ✧.*
‧₊˚.🏙️⊹{city} ┊ 🌪️⊹{wind:mph} mph✧.*</textarea></label>
        <label>Big image URL, mỗi dòng 1 ảnh<textarea id="bigimg">https://i.postimg.cc/m260tXC1/snaptik-vn-7599849318195186965-14.jpg</textarea></label>
        <label>Small image URL, mỗi dòng 1 ảnh<textarea id="smallimg">https://i.postimg.cc/VkCH5YzD/giphy.gif</textarea></label>
        <label>Button 1, name tối đa 32 byte UTF-8<textarea id="button1">🍧 Discord|https://discord.gg/cy65PCXb2e</textarea></label>
        <label>Button 2, name tối đa 32 byte UTF-8<textarea id="button2">🍭 Kết nối|https://discord.gg/cy65PCXb2e</textarea></label>
        </div>
        <div class="config-toolbar" aria-label="Thao tác scene">
          <button class="json-select-trigger" id="openJson" type="button" aria-haspopup="dialog" aria-controls="jsonDialog"><span>JSON scene</span><span class="json-select-value">Mở xem</span></button>
          <div class="actions rpc-config-actions">
            <button class="feature-toggle" id="rpcToggle" type="button" disabled>Tắt chức năng</button>
            <button class="save-control" id="save" disabled>Lưu scene & Discord</button>
          </div>
          <div id="errors" role="status" aria-live="polite"></div>
        </div>
      </section>
      <section class="rpc-side">
        <div class="rpc-preview-card">
          <div class="preview-label"><span>Xem trước</span><span id="previewType">RICH PRESENCE</span></div>
          <div class="rpc-preview">
          <div class="preview-kicker"><span><span id="previewName">Naiya</span><img class="preview-platform" id="previewPlatform" src="https://upload.wikimedia.org/wikipedia/commons/a/ab/Meta-Logo.png" alt="Meta Quest" hidden></span></div>
          <div class="preview-body">
            <div class="preview-art"><img id="previewBig" alt=""><img id="previewSmall" alt=""></div>
            <div class="preview-copy"><div class="preview-activity-name" id="previewActivityName" hidden></div><div id="previewDetails">...</div><div id="previewState">...</div><div class="preview-muted" id="previewAssetText"></div><div class="preview-muted preview-timestamp" id="previewTimestamp" hidden><span id="previewTypeIcon">♪</span> </div><div class="preview-buttons" id="previewButtons"></div></div>
          </div>
          </div>
        </div>
      </section>
    </div>
    </section>
    <section class="page" id="page-plan" hidden>
      <h1 class="account-plan-title" id="accountPlanTitle" hidden>Quản lý gói</h1>
      <div class="account-plan-summary" id="accountPlanSummary" hidden>
        <div class="actions" id="planOffers"></div><p class="billing-note" id="planSummary" role="status" aria-live="polite"></p>
        <p class="billing-note" id="billingStatus"></p>
      </div>
    </section>
    <section class="page" id="page-deposit" hidden>
      <h1>Nạp tiền</h1>
      <div class="billing-box">
        <div class="deposit-summary"><div class="billing-stat">Số dư<b id="billingBalance">0đ</b></div><div class="deposit-limits"><span>Tối thiểu<b>10.000 VND</b></span><i></i><span>Tối đa<b id="depositMaxValue">Không giới hạn</b></span></div></div>
        <div class="deposit-tabs" role="tablist" aria-label="Phương thức nạp tiền"><button id="depositBankTab" type="button" role="tab" aria-selected="true" aria-controls="depositBankPanel">Ngân hàng</button><button id="depositCardTab" type="button" role="tab" aria-selected="false" aria-controls="depositCardPanel" tabindex="-1">Thẻ cào</button></div>
        <div id="depositBankPanel" class="deposit-method" role="tabpanel" aria-labelledby="depositBankTab"><div class="billing-form"><label>Số tiền nạp<input id="depositAmount" type="text" inputmode="numeric" autocomplete="off" placeholder="Vui lòng nhập số tiền trên 10.000 VND"></label><button id="depositSepay" disabled>Xác nhận</button></div></div>
        <div id="depositCardPanel" class="deposit-method" role="tabpanel" aria-labelledby="depositCardTab" hidden><div class="billing-form card-billing-form"><label>Nhà mạng<select id="cardTelco"><option value="VIETTEL">Viettel</option><option value="VINAPHONE">Vinaphone</option><option value="MOBIFONE">Mobifone</option><option value="VNMOBI">Vietnamobile</option><option value="GARENA2">Garena</option><option value="ZING">Zing</option></select></label><label>Mệnh giá<select id="cardAmount"><option value="10000">10.000đ</option><option value="20000">20.000đ</option><option value="30000">30.000đ</option><option value="50000">50.000đ</option><option value="100000">100.000đ</option><option value="200000">200.000đ</option><option value="300000">300.000đ</option><option value="500000">500.000đ</option><option value="1000000">1.000.000đ</option></select></label><label>Serial<input id="cardSerial" type="text" inputmode="text" autocomplete="off" maxlength="24"></label><label>Mã thẻ<input id="cardCode" type="text" inputmode="text" autocomplete="off" maxlength="24"></label><button id="depositCard" disabled>Nạp thẻ</button></div><div class="card-receive" id="cardReceive" role="status"><span>Mệnh giá thực nhận</span><b>Đang tải bảng phí</b><small></small></div></div>
        <p class="billing-note" id="depositMessage" role="status"></p>
      </div>
      <div class="billing-box"><h2>Lịch sử giao dịch</h2><div class="topup-list" id="topupList"></div></div>
    </section>
    <section class="page" id="page-main">
      <div class="account-home">
        <header class="account-home-intro">
          <p>ACCOUNT STATUS</p>
          <h1 id="homeGreeting">Xin chào</h1>
          <span>Kiểm tra nhanh tài khoản Discord và các tính năng đang sẵn sàng.</span>
        </header>
        <article class="account-home-profile">
          <div class="account-home-identity">
            <img id="homeAvatar" alt="" hidden>
            <span id="homeAvatarFallback" aria-hidden="true">?</span>
            <div><strong id="homeUsername">Tài khoản chưa liên kết</strong><small id="homeUserId">ID: —</small></div>
          </div>
          <dl>
            <div><dt>Gói đang dùng</dt><dd id="homePlanName">Free</dd></div><div><dt>Thời hạn:</dt><dd id="homePlanExpiry"><span id="homePlanExpiryTime">Không thời hạn</span><span id="homePlanExpiryDate"></span></dd></div>
          </dl>
        </article>
        <section class="account-home-status" aria-labelledby="homeStatusTitle">
          <header><i aria-hidden="true"></i><div><h2 id="homeStatusTitle">Trạng thái tài khoản</h2><p id="homeSummary">Tài khoản chưa liên kết</p></div></header>
          <nav class="feature-slot-nav" id="featureSlotNav" aria-label="Chọn token xem trạng thái" hidden><button id="featureSlotPrev" type="button" aria-label="Token trước">‹</button><b id="featureSlotLabel">TOKEN 1</b><button id="featureSlotNext" type="button" aria-label="Token sau">›</button></nav>
          <div class="feature-status-marquee" aria-hidden="true"><div class="feature-status-track" id="featureStatusTrack"></div></div>
          <p class="feature-status-text" id="featureStatusText" aria-live="polite"></p>
        </section>
      </div>
      <div class="billing-box account-plan-slots" id="accountPlanSlots" hidden><h2 class="account-plan-slots-title">Quản lý token</h2><div id="slotList"></div></div>
    </section>
    <section class="page admin-page" id="page-admin" hidden>
      <header class="admin-page-head"><div><span>SuperUtils Control</span><h1>Quản trị</h1></div><p>Account, token và giao dịch.</p></header>
      <div class="admin-control-center" id="adminBilling" hidden>
        <div class="admin-metrics" aria-label="Tổng quan quản trị">
          <article data-admin-metric><span>Tổng account</span><strong id="adminMetricUsers">0</strong></article>
          <article data-admin-metric><span>Token lỗi</span><strong id="adminMetricInvalid">0</strong></article>
          <article data-admin-metric><span>Sắp hết hạn</span><strong id="adminMetricExpiring">0</strong></article>
          <article data-admin-metric><span>Đã khóa</span><strong id="adminMetricLocked">0</strong></article>
        </div>
        <div class="admin-command-layout">
          <aside class="admin-directory">
            <div class="admin-panel-heading"><div><h2>Account</h2></div></div>
            <div class="admin-filters"><input id="adminSearch" type="search" placeholder="Tìm account…" aria-label="Tìm account"><div class="admin-chips"><button type="button" data-admin-filter="all" class="active">Tất cả</button><button type="button" data-admin-filter="invalid">Token lỗi</button><button type="button" data-admin-filter="expiring">Sắp hết hạn</button></div></div>
            <div id="adminOverview" class="admin-overview-table"></div>
          </aside>
          <div class="admin-workspace">
            <div class="admin-panel-heading"><div><h2>Chi tiết account</h2></div></div>
            <div class="admin-user-toolbar"><label>Chọn account<select id="adminBillingUser" aria-label="Chọn account cần quản trị"></select></label><div id="adminUserSummary" class="admin-user-summary"></div></div>
            <div class="admin-action-grid"><div class="admin-action-card"><h3>Gói</h3><div class="admin-user-actions"><label>Gói mới<select id="adminPlanId"><option value="p40">Luna</option><option value="p60">Terra</option><option value="p90">Sol</option></select></label><button id="adminChangePlan">Đổi gói</button></div></div>
              <div class="admin-action-card"><h3>Số dư</h3><div class="admin-user-actions"><label>Số tiền cộng<input id="adminCredit" type="number" min="1" value="30000"></label><button id="adminAddCredit">Cộng tiền</button><label>Số tiền trừ<input id="adminDebitAmount" type="number" min="1" value="30000"></label><button id="adminDebitBtn">Trừ tiền</button></div></div>
            </div>
            <div class="admin-bulk-bar" id="adminBulkBar" hidden><label class="admin-bulk-check"><input type="checkbox" id="adminCheckAll">Chọn tất cả</label><input type="number" id="adminBulkDays" value="30" min="1" max="3650" title="Số ngày cộng"><button id="adminBulkExtend">Cộng ngày</button><span id="adminBulkCount" class="admin-bulk-count"></span></div>
            <div class="admin-token-panel"><div class="admin-panel-heading compact"><div><h2>Token</h2></div></div><div id="adminSlotDates" class="admin-slot-dates"></div></div>
            <div class="admin-history-grid"><details class="admin-history" id="adminPaymentsBox"><summary>Lịch sử thanh toán</summary><div id="adminPayments" class="admin-history-body"></div></details><details class="admin-history"><summary>Nhật ký quản trị</summary><div id="adminLogs" class="admin-history-body"></div></details></div>
            <p id="adminBillingMessage" class="billing-note admin-message" role="status"></p>
          </div>
        </div>
      </div>
    </section>
    <section class="page" id="page-voice">
      <h1>Tạo Voice Config</h1>
      <div class="config-slot-switcher" data-slot-switcher hidden>
        <label>Token cấu hình<select data-slot-select aria-label="Chọn slot cấu hình"></select></label>
        <span>Mỗi slot dùng một bộ config riêng.</span>
      </div>
      <div class="grid">
        <section>
          <label>Guild ID<input id="voiceGuild" placeholder="Server ID"></label>
          <label>Channel ID<input id="voiceChannel" placeholder="Voice channel ID"></label>
          <div class="row">
            <label>Stream<select id="voiceStream"><option value="true">Bật</option><option value="false">Tắt</option></select></label>
            <label>Camera<select id="voiceCamera"><option value="false">Tắt</option><option value="true">Bật</option></select></label>
          </div>
          <div class="row">
            <label>Mic<select id="voiceMute"><option value="true">Bật</option><option value="false">Tắt</option></select></label>
            <label>Loa<select id="voiceDeaf"><option value="false">Tắt</option><option value="true">Bật</option></select></label>
          </div>
          <label>Refresh ms<input id="voiceRefresh" type="number" min="5000" value="60000"></label>
        </section>
        <section>
          <div id="voiceErrors"></div>
          <textarea id="voiceOutput" spellcheck="false"></textarea>
          <div class="actions">
