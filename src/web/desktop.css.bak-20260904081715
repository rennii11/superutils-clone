/* Comic co dien theme: red-yellow-blue accents on black-ink/white-paper comic base. */
:root{
  /* Primitive tokens */
  --manga-paper:oklch(.985 .006 90);
  --manga-paper-soft:oklch(.95 .008 88);
  --manga-paper-muted:oklch(.90 .010 85);
  --manga-ink:oklch(.16 .01 260);
  --manga-ink-soft:oklch(.34 .012 260);
  --manga-gray:oklch(.55 .01 260);
  --manga-stroke:3px;
  --manga-stroke-thin:2px;
  --manga-gutter:18px;
  --manga-space-1:6px;
  --manga-space-2:10px;
  --manga-space-3:14px;
  --manga-space-4:18px;
  --manga-space-5:24px;
  --manga-space-6:32px;
  --manga-radius:1px;
  --manga-shadow-sm:4px 4px 0 var(--manga-ink);
  --manga-shadow-md:7px 7px 0 var(--manga-ink);
  --manga-shadow-lg:10px 10px 0 var(--manga-ink);
  --comic-red:oklch(.58 .21 25);
  --comic-red-strong:oklch(.50 .22 25);
  --comic-yellow:oklch(.86 .17 95);
  --comic-yellow-strong:oklch(.80 .18 90);
  --comic-blue:oklch(.52 .18 255);
  --comic-blue-strong:oklch(.44 .19 258);
  --comic-green:oklch(.62 .16 148);
  --comic-halftone:radial-gradient(circle,var(--manga-ink) .6px,transparent .62px);
  --comic-halftone-accent:radial-gradient(circle,var(--comic-blue) .6px,transparent .62px);

  /* Semantic tokens */
  --color-background:var(--manga-paper-muted);
  --color-surface:var(--manga-paper);
  --color-surface-muted:var(--manga-paper-soft);
  --color-foreground:var(--manga-ink);
  --color-muted-foreground:var(--manga-ink-soft);
  --color-border:var(--manga-ink);
  --color-focus:var(--comic-blue);
  --color-accent:var(--comic-yellow);
  --color-success:var(--comic-green);
  --color-warning:var(--comic-yellow-strong);
  --color-danger:var(--comic-red);

  /* Component tokens */
  --panel-bg:var(--color-surface);
  --panel-border:var(--color-border);
  --panel-shadow:var(--manga-shadow-md);
  --button-bg:var(--comic-blue);
  --button-bg-hover:var(--comic-blue-strong);
  --button-bg-active:var(--manga-paper-muted);
  --button-fg:var(--manga-paper);
  --button-fg-hover:var(--manga-paper);
  --input-bg:var(--manga-paper);
  --input-border:var(--manga-ink);
  --input-focus-ring:var(--comic-blue);
  --card-bg:var(--panel-bg);
  --card-border:var(--panel-border);
  --card-shadow:var(--panel-shadow);
  --night:var(--manga-paper-muted);
  --deep:var(--manga-paper);
  --surface:var(--manga-paper);
  --surface-raised:var(--manga-paper);
  --ink:var(--manga-ink);
  --soft:var(--manga-ink-soft);
  --muted:var(--manga-gray);
  --line:var(--manga-ink);
  --cyan:var(--comic-blue);
  --cyan-dark:var(--manga-paper);
  --violet:var(--manga-ink)
}

