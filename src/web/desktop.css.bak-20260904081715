/* Fixed monochrome theme switch. It floats above panels without changing layout. */
:root[data-theme="dark"]{
  --manga-paper:oklch(.19 .014 258);
  --manga-paper-soft:oklch(.24 .016 258);
  --manga-paper-muted:oklch(.15 .012 258);
  --manga-ink:oklch(.94 .006 90);
  --manga-ink-soft:oklch(.76 .01 90);
  --manga-gray:oklch(.57 .010 92);
  --manga-stroke:2px;
  --manga-stroke-thin:1px;
  --manga-shadow-sm:4px 4px 0 oklch(.26 .022 85);
  --manga-shadow-md:6px 6px 0 oklch(.26 .022 85);
  --manga-shadow-lg:8px 8px 0 oklch(.26 .022 85);
  --comic-red:oklch(.68 .18 25);
  --comic-red-strong:oklch(.74 .18 25);
  --comic-yellow:oklch(.82 .15 95);
  --comic-yellow-strong:oklch(.78 .16 90);
  --comic-blue:oklch(.70 .15 255);
  --comic-blue-strong:oklch(.76 .14 255);
  --comic-green:oklch(.72 .15 148);
  --color-background:var(--manga-paper-muted);
  --color-surface:var(--manga-paper);
  --color-surface-muted:var(--manga-paper-soft);
  --color-foreground:var(--manga-ink);
  --color-muted-foreground:var(--manga-ink-soft);
  --color-border:var(--manga-ink);
  --color-focus:var(--comic-blue);
  --color-accent:var(--comic-yellow);
  --color-success:var(--comic-green);
  --color-warning:var(--comic-yellow-strong);
  --color-danger:var(--comic-red);
  --panel-bg:var(--manga-paper);
  --panel-border:var(--manga-ink);
  --button-bg:var(--comic-blue);
  --button-bg-hover:var(--comic-blue-strong);
  --button-bg-active:var(--manga-paper-soft);
  --button-fg:var(--manga-paper);
  --button-fg-hover:var(--manga-paper);
  --input-bg:var(--manga-paper);
  --input-border:var(--manga-ink);
  --input-focus-ring:var(--comic-blue);
  --card-bg:var(--manga-paper);
  --card-border:var(--manga-ink);
  --night:var(--manga-paper-muted);
  --deep:var(--manga-paper);
  --surface:var(--manga-paper);
  --surface-raised:var(--manga-paper-soft);
  --ink:var(--manga-ink);
  --soft:var(--manga-ink-soft);
  --muted:var(--manga-gray);
  --line:var(--manga-ink);
  --cyan:var(--comic-blue);
  --cyan-dark:var(--manga-paper);
  --violet:var(--manga-ink)
}
html[data-theme="dark"]{background:var(--color-background);color-scheme:dark}

.theme-toggle{
  position:fixed;
  right:18px;
  bottom:max(18px,env(safe-area-inset-bottom));
  z-index:120;
  width:auto;
  height:auto;
  min-height:44px;
