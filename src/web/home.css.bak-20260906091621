@font-face{font-family:"Be Vietnam Pro";font-style:normal;font-weight:400;font-display:swap;src:url("/font-be-vietnam-pro-400.ttf") format("truetype")}
@font-face{font-family:"Be Vietnam Pro";font-style:normal;font-weight:500;font-display:swap;src:url("/font-be-vietnam-pro-500.ttf") format("truetype")}
@font-face{font-family:"Be Vietnam Pro";font-style:normal;font-weight:600;font-display:swap;src:url("/font-be-vietnam-pro-600.ttf") format("truetype")}
@font-face{font-family:"Be Vietnam Pro";font-style:normal;font-weight:800;font-display:swap;src:url("/font-be-vietnam-pro-800.ttf") format("truetype")}
@font-face{font-family:"Little Thiing";font-style:normal;font-weight:400;font-display:swap;src:url("/Little-Thiing-Regular.otf") format("opentype")}

:root{
  --ink:#FFFFFF;
  --ink-on-accent:#1A1200;
  --muted:#9A9A9A;
  --line:rgba(255,255,255,.14);
  --accent:#F59E0B;
  --accent-hover:#D97706;
  --accent-bright:#FBBF24;
  --signal:#22C55E;
  --radius-sm:6px;
  --container:1080px;
}

*{box-sizing:border-box}
::selection{background:rgba(154,154,154,.4);color:var(--ink)}
html{scroll-behavior:smooth;background:#000000;min-height:100%}
body{
  margin:0;
  min-height:100dvh;
  background:radial-gradient(1000px 560px at 55% 0%,rgba(245,158,11,.12),transparent 62%),#000000;
  color:var(--ink);
  font:400 16px/1.6 "Be Vietnam Pro","Segoe UI",sans-serif;
  -webkit-font-smoothing:antialiased;
}
a{color:inherit}
button,a{touch-action:manipulation}
img{max-width:100%;display:block}
:focus-visible{outline:2px solid var(--accent-bright);outline-offset:3px}

.eyebrow{
  margin:0 0 14px;
  font-size:12px;
  font-weight:600;
  letter-spacing:.14em;
  text-transform:uppercase;
  color:var(--muted);
}

/* -- nav -- */
.nav-bar{
  position:sticky;
  top:0;
  z-index:50;
  background:rgba(0,0,0,.35);
  backdrop-filter:blur(20px);
  -webkit-backdrop-filter:blur(20px);
}
.nav{
  max-width:var(--container);
  margin:0 auto;
  padding:18px 24px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}
.brand{
  display:inline-flex;
  align-items:center;
  gap:9px;
  font:400 28px/1 "Little Thiing","Be Vietnam Pro",sans-serif;
  letter-spacing:0;
  text-decoration:none;
}
.brand-dot{
  width:8px;height:8px;border-radius:50%;
  background:var(--signal);
  box-shadow:0 0 0 4px rgba(34,197,94,.18);
}
.nav-links{display:flex;align-items:center;gap:22px}
.nav-links a{font-size:14px;font-weight:600;text-decoration:none;color:var(--muted)}
.nav-links a:hover{color:var(--ink)}
.nav-cta{
  padding:9px 16px;
  border-radius:var(--radius-sm);
  background:var(--accent)!important;
  color:var(--ink-on-accent)!important;
  font-weight:700;
  transition:background .18s ease,transform .12s ease;
}
.nav-cta:hover{background:var(--accent-hover)!important}
.nav-cta:active{transform:scale(.97)}

/* -- hero -- */
.hero{
  max-width:var(--container);
  margin:0 auto;
  padding:40px 24px 48px;
  display:grid;
  grid-template-columns:minmax(0,1.15fr) minmax(280px,.85fr);
  gap:48px;
  align-items:center;
}

.discord-card{
  width:100%;
  max-width:360px;
  margin:0 auto;
  background:#111214;
  border-radius:16px;
  overflow:hidden;
  border:1px solid var(--line);
  box-shadow:0 24px 60px rgba(0,0,0,.55);
}
.discord-banner{
  height:100px;
  background:linear-gradient(135deg,var(--accent) 0%,var(--accent-hover) 100%) center/cover;
}
.discord-body{padding:0 18px 18px;position:relative}
.discord-avatar-wrap{position:relative;width:84px;height:84px;margin-top:-42px;margin-bottom:10px}
.discord-avatar-img{
  position:relative;
  width:84px;height:84px;
  border-radius:50%;
  border:6px solid #111214;
  background:#1A1200;
  object-fit:cover;
  display:block;
}
.discord-decoration{
  position:absolute;
  top:50%;left:50%;
  width:120%;height:120%;
  transform:translate(-50%,-50%);
  object-fit:contain;
  pointer-events:none;
  z-index:2;
}
.discord-status{
  position:absolute;
  right:2px;bottom:8px;
  width:20px;height:20px;
  border-radius:50%;
  background:var(--signal);
  border:4px solid #111214;
  z-index:3;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:11px;
  line-height:1;
}
.discord-identity{display:flex;flex-direction:column;gap:4px}
.discord-identity b{font-size:18px;font-weight:800;color:#fff}
.discord-identity span{font-size:13px;color:var(--muted)}
.discord-identity-row{display:flex;align-items:center;flex-wrap:wrap;gap:8px}
.discord-clan-tag{
  display:inline-flex;
  align-items:center;
  gap:4px;
  padding:2px 8px 2px 4px;
  border-radius:999px;
  background:rgba(255,255,255,.08);
  font-size:12px;
  font-weight:600;
}
.discord-clan-tag img{width:14px;height:14px;border-radius:50%}
.discord-badge{width:20px;height:20px}
#discordBadges{display:inline-flex;gap:6px}
.discord-activity{
  margin-top:16px;
  padding:12px;
  background:rgba(255,255,255,.05);
  border-radius:8px;
}
.discord-activity-kicker{
  font-size:11.5px;
  font-weight:600;
  letter-spacing:.01em;
  color:var(--muted);
  margin-bottom:8px;
}
.discord-activity-row{
  display:flex;
  gap:12px;
  align-items:center;
}
.discord-activity-icon{
  flex:none;
  width:44px;height:44px;
  border-radius:8px;
  background:var(--accent) center/cover;
}
.discord-activity-text{display:flex;flex-direction:column;gap:2px}
.discord-activity-text em{font-size:13px;font-weight:700;font-style:normal;color:#fff}
.discord-activity-text span{font-size:12.5px;color:var(--muted)}
.discord-activity-text small{font-size:11px;color:var(--muted);opacity:.7}
.discord-activity-buttons{display:flex;flex-direction:column;gap:8px;margin-top:12px}
.discord-activity-buttons a{
  display:block;
  text-align:center;
  padding:8px 12px;
  border-radius:999px;
  background:rgba(255,255,255,.08);
  color:#fff;
  font-size:12.5px;
  font-weight:600;
  text-decoration:none;
  transition:background .15s ease,transform .12s ease;
}
.discord-activity-buttons a:hover{background:rgba(255,255,255,.14)}
.discord-activity-buttons a:active{transform:scale(.97)}

.highlights{
  border-top:1px solid var(--line);
  border-bottom:1px solid var(--line);
}
.highlights-inner{
  max-width:var(--container);
  margin:0 auto;
  padding:28px 24px;
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  gap:12px 40px;
}
.highlights-inner h2{
  margin:0;
  font-size:20px;
  font-weight:800;
  letter-spacing:-.01em;
}
.highlights-list{
  display:flex;
  flex-wrap:wrap;
  gap:12px 32px;
}
.highlight{
  position:relative;
  padding-left:16px;
  font-size:13.5px;
  color:var(--muted);
}
.highlight::before{
  content:'';
  position:absolute;
  left:0;top:50%;
  transform:translateY(-50%);
  width:6px;height:6px;
  border-radius:50%;
  background:var(--signal);
}
.hero-text h1{
  margin:0 0 22px;
  font-size:clamp(40px,6vw,80px);
  font-weight:800;
  line-height:.98;
  letter-spacing:-.03em;
}
.hero-text h1 em{
  font-style:normal;
  color:var(--accent-bright);
}
.lede{
  max-width:46ch;
  margin:0;
  font-size:17px;
  line-height:1.65;
  color:var(--muted);
}
.hero-actions{
  display:flex;
  align-items:center;
  gap:22px;
  margin-top:34px;
  flex-wrap:wrap;
}
.btn-primary{
  padding:13px 22px;
  border-radius:var(--radius-sm);
  background:var(--accent);
  color:var(--ink-on-accent);
  font-size:15px;
  font-weight:700;
  text-decoration:none;
  transition:background .18s ease,transform .18s ease;
}
.btn-primary:hover{background:var(--accent-hover);transform:translateY(-1px)}
.btn-primary:active{transform:scale(.97)}
.btn-ghost{
  font-size:15px;
  font-weight:600;
  text-decoration:none;
  color:var(--ink);
  border-bottom:1px solid var(--line);
  padding-bottom:2px;
  transition:border-color .18s ease,color .18s ease;
}
.btn-ghost:hover{color:var(--accent-bright);border-color:var(--accent-bright)}
.btn-ghost:active{opacity:.7}

/* -- shared section head -- */
.section-head{
  max-width:var(--container);
  margin:0 auto;
  padding:0 24px;
}
.section-head h2{
  margin:8px 0 0;
  font-size:clamp(30px,4.2vw,52px);
  font-weight:800;
  line-height:1.04;
  letter-spacing:-.02em;
}

/* -- modules -- */
.modules{padding:64px 0 48px}
.module-list{
  max-width:var(--container);
  margin:48px auto 0;
  padding:0 24px;
}
.module-row{
  display:grid;
  grid-template-columns:20px minmax(0,220px) minmax(0,1fr);
  align-items:baseline;
  gap:20px;
  padding:22px 0;
  border-top:1px solid var(--line);
  transition:background .18s ease;
}
.module-list .module-row:last-child{border-bottom:1px solid var(--line)}
.module-row .dot{
  width:7px;height:7px;border-radius:50%;
  background:var(--signal);
  align-self:center;
}
.module-row h3{margin:0;font-size:18px;font-weight:700}
.module-row p{margin:0;font-size:14.5px;line-height:1.55;color:var(--muted)}
.module-row:hover{background:rgba(255,255,255,.06)}

/* -- final cta -- */
.final-inner{
  max-width:var(--container);
  margin:64px auto 0;
  padding:0 24px;
  text-align:center;
}
.final-inner h2{
  margin:0 0 10px;
  font-size:clamp(28px,4.4vw,48px);
  font-weight:800;
  letter-spacing:-.02em;
}
.final-inner .price-slot{margin:0 0 8px;font-size:14.5px;color:var(--ink)}
.final-inner .price-note{margin:0 0 24px;font-size:14.5px;color:var(--muted)}

/* -- footer -- */
.foot{padding:28px 0 52px}
.foot-inner{
  max-width:var(--container);
  margin:0 auto;
  padding:0 24px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  font-size:13px;
  color:var(--muted);
}
.foot-inner a{text-decoration:none;color:inherit}
.foot-inner a:hover{color:var(--ink)}

/* -- scroll reveal -- */
.reveal{opacity:0;filter:blur(8px);transform:translateY(18px);transition:opacity .9s cubic-bezier(.16,1,.3,1),filter .9s cubic-bezier(.16,1,.3,1),transform .9s cubic-bezier(.16,1,.3,1)}
.reveal.reveal-visible{opacity:1;filter:none;transform:none}

@media(max-width:820px){
  .hero{grid-template-columns:1fr;gap:32px;padding:24px 20px 40px}
  .discord-card{max-width:400px;margin:0 auto}
  .nav{padding:14px 20px}
  .nav-links a:not(.nav-cta){display:none}
  .module-row{grid-template-columns:16px 1fr;row-gap:6px}
  .module-row h3{grid-column:2}
  .module-row p{grid-column:2}
  .foot{padding:20px 0 40px}
  .foot-inner{padding:0 20px}
}

@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .reveal{opacity:1;filter:none;transform:none;transition:none}
}
